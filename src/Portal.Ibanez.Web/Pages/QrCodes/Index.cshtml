@page
@using Portal.Ibanez.Localization
@using Portal.Ibanez.Web.Pages.QrCodes
@using Microsoft.Extensions.Localization
@model IndexModel
@inject IStringLocalizer<IbanezResource> L

@section scripts {
    <script>
        $(function () {
            // Referencia al servicio de tu backend
            var qrService = portal.ibanez.qrCodes.qrCode;

            // Inicializamos modales
            var createModal = new abp.ModalManager(abp.appPath + 'QrCodes/CreateModal');
            var editModal = new abp.ModalManager(abp.appPath + 'QrCodes/EditModal');

            // Nuevo QR
            $('#NewQrCodeButton').click(function (e) {
                e.preventDefault();
                createModal.open({ machineId: $('#MachineId').val() });
            });

            // Editar QR
            $(document).on('click', '.edit-qr-btn', function (e) {
                e.preventDefault();
                editModal.open({ id: $(this).data('id') });
            });

            // Eliminar QR con confirmación
            $(document).on('click', '.delete-qr-btn', function (e) {
                e.preventDefault();
                var id = $(this).data('id');

                abp.message.confirm('¿Seguro que deseas eliminar este QR?', function (isConfirmed) {
                    if (isConfirmed) {
                        qrService.delete(id).then(function () {
                            abp.notify.success('QR eliminado correctamente');
                            window.location.reload();
                        });
                    }
                });
            });

            // Aviso si no hay carpeta asociada
            $(document).on('click', '.no-folder-btn', function (e) {
                e.preventDefault();
                abp.notify.warn('Este QR no tiene una carpeta asociada.');
            });

            // Recargar al guardar
            createModal.onResult(function () { window.location.reload(); });
            editModal.onResult(function () { window.location.reload(); });

            // Copiar código al portapapeles
            $(document).on('click', '.copy-url-btn', function (e) {
                e.preventDefault();
                var code = $(this).data('url');
                navigator.clipboard.writeText(code).then(function () {
                    abp.notify.success("¡Código copiado al portapapeles!");
                });
            });
        });
    </script>
}

<input type="hidden" id="MachineId" value="@Model.MachineId" />

<style>
    body {
        background-color: #f4f7f9;
        font-family: 'Inter', system-ui, sans-serif;
    }

    /* Botón principal */
    .btn-brand {
        background-color: #c71712;
        color: white;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s;
        box-shadow: 0 4px 6px -1px rgba(199, 23, 18, 0.2);
    }

        .btn-brand:hover {
            background-color: #a5130f;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 8px -1px rgba(199, 23, 18, 0.3);
        }

    /* Tarjetas QR */
    .qr-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .qr-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 25px -5px rgba(0,0,0,0.08);
            border-color: #cbd5e1;
        }

    /* Contenedor visual del QR */
    .qr-visual-container {
        background: repeating-linear-gradient( 45deg, #f8fafc, #f8fafc 10px, #ffffff 10px, #ffffff 20px );
        padding: 2rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #f1f5f9;
        position: relative;
    }

    .qr-mockup {
        width: 120px;
        height: 120px;
        background-color: white;
        border-radius: 12px;
        padding: 10px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Badge flotante de estado */
    .qr-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.25rem 0.6rem;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        backdrop-filter: blur(4px);
        border: 1px solid transparent;
    }

    /* Información de la tarjeta */
    .qr-info {
        padding: 1.25rem;
        flex-grow: 1;
    }

    .qr-url-box {
        background-color: #f8fafc;
        border: 1px dashed #cbd5e1;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
    }

    .qr-url-text {
        font-family: 'JetBrains Mono', monospace, sans-serif;
        font-size: 0.75rem;
        color: #475569;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex-grow: 1;
    }

    /* Footer de botones */
    .qr-actions {
        padding: 1rem 1.25rem;
        background-color: #f8fafc;
        border-top: 1px solid #f1f5f9;
        display: flex;
        gap: 8px;
    }

    .btn-action-primary {
        background-color: #1e293b;
        color: white;
        font-weight: 600;
        font-size: 0.75rem;
        flex-grow: 1;
        border-radius: 8px;
        padding: 0.5rem;
        border: none;
        transition: background-color 0.2s;
        text-align: center;
        text-decoration: none;
    }

        .btn-action-primary:hover {
            background-color: #0f172a;
            color: white;
        }

    .btn-action-secondary {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        color: #475569;
        border-radius: 8px;
        padding: 0.5rem 0.6rem;
        transition: all 0.2s;
    }

        .btn-action-secondary:hover {
            background-color: #f1f5f9;
            color: #1e293b;
            border-color: #94a3b8;
        }
</style>

<!-- Cabecera -->
<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white p-4 border rounded-4 shadow-sm gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                <li class="breadcrumb-item text-muted">Administración</li>
                <li class="breadcrumb-item text-muted">Máquinas</li>
                <li class="breadcrumb-item" style="color: #c71712;">Códigos QR</li>
            </ol>
        </nav>
        <h2 class="h4 font-weight-bold text-dark mb-0 d-flex align-items-center gap-2">
            <div class="p-2 bg-light rounded-3 text-secondary d-flex align-items-center justify-content-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M2 2h2v2H2V2Z" />
                    <path d="M6 0v6H0V0h6ZM5 1H1v4h4V1ZM4 12H2v2h2v-2Z" />
                    <path d="M6 10v6H0v-6h6Zm-5 1v4h4v-4H1Zm11-9h2v2h-2V2Z" />
                    <path d="M10 0h6v6h-6V0Zm5 1h-4v4h4V1ZM8 1V0h1v2H8v2H7V1h1Zm0 5V4h1v2H8ZM6 8V7h1V6h1v2h1V7h5v1h-4v1H7V8H6Zm0 0v1H2V8H1v1H0V7h3v1h3Zm10 1h-1V7h1v2Zm-1 0h-1v2h2v-1h-1V9Zm-4 0h2v1h-1v1h-1V9Zm2 3v-1h-1v1h-1v1H9v1h3v-2h1Zm0 0h3v1h-2v1h-1v-2Zm-4-1v1h1v-2H7v1h2Z" />
                    <path d="M7 12h1v3H4v1H3v-2h3v-1h1v-1Zm3 0h-1v1h-1v-2h2v1Zm2 2v-1h-2v1h2Zm-1 1h2v1h-2v-1Z" />
                </svg>
            </div>
            @Model.Title
        </h2>
    </div>

    <div>
        <button type="button" id="NewQrCodeButton" class="btn btn-brand d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
            </svg>
            Nuevo QR
        </button>
    </div>
</div>

<!-- Grid de Códigos QR -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
    @if (Model.QrCodes != null && Model.QrCodes.Any())
    {
        foreach (var qr in Model.QrCodes)
        {
            <div class="col">
                <div class="qr-card shadow-sm">
                    <!-- Área Visual -->
                    <div class="qr-visual-container">
                        @if (qr.IsActive)
                        {
                            <span class="qr-badge" style="background-color: #dcfce7; color: #166534; border-color: #bbf7d0;">Activo</span>
                        }
                        else
                        {
                            <span class="qr-badge" style="background-color: #f1f5f9; color: #64748b; border-color: #cbd5e1;">Inactivo</span>
                        }

                        <div class="qr-mockup">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=@qr.Code" alt="QR Code" class="img-fluid rounded" style="opacity: 0.9;" />
                        </div>
                    </div>

                    <!-- Datos -->
                    <div class="qr-info">
                        <h3 class="h6 fw-bold text-dark mb-1 text-truncate" title="@qr.Name">@qr.Name</h3>
                        <p class="text-muted small mb-0" style="font-size: 0.75rem;">Generado el @(qr.CreationTime.ToString("dd/MM/yyyy"))</p>

                        @if (!string.IsNullOrEmpty(qr.Description))
                        {
                            <p class="text-secondary mt-2 mb-0 text-truncate" style="font-size: 0.75rem;" title="@qr.Description">@qr.Description</p>
                        }

                        <div class="qr-url-box mt-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#94a3b8" viewBox="0 0 16 16">
                                <path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1.002 1.002 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4.018 4.018 0 0 1-.128-1.287z" />
                                <path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243L6.586 4.672z" />
                            </svg>
                            <span class="qr-url-text" title="@qr.Code">@qr.Code</span>
                            <button type="button" class="btn btn-sm btn-link p-0 text-secondary copy-url-btn" data-url="@qr.Code" title="Copiar código">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V2Zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H6ZM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2-2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1H2Z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Botonera -->
                    <div class="qr-actions">

                        @if (qr.DocumentFolderId.HasValue)
                        {
                            <!-- Ir a la Carpeta Relacionada -->
                            <a href="/MachineDocuments?machineId=@qr.MachineId&documentFolderId=@qr.DocumentFolderId" class="btn-action-primary d-flex align-items-center justify-content-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3zm-8.322.12C1.72 3.042 1.95 3 2.19 3h5.396l-.707-.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139z" /></svg>
                                Abrir carpeta
                            </a>
                        }
                        else
                        {
                            <!-- Botón que muestra la advertencia si no hay carpeta -->
                            <button type="button" class="btn-action-primary no-folder-btn d-flex align-items-center justify-content-center gap-2" style="background-color: #64748b;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3zm-8.322.12C1.72 3.042 1.95 3 2.19 3h5.396l-.707-.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139z" /></svg>
                                Sin carpeta
                            </button>
                        }

                        <div class="dropdown">
                            <button class="btn-action-secondary d-flex align-items-center justify-content-center h-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z" /></svg>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1 p-2" style="font-size: 0.85rem; border-radius: 10px;">
                                <li>
                                    <!-- Abre la ruta original que tenías para la imagen -->
                                    <a href="/QrCodes/Image/@qr.Id" target="_blank" class="dropdown-item d-flex align-items-center gap-2 py-2 rounded">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#64748b" viewBox="0 0 16 16"><path d="M5 1a2 2 0 0 0-2 2v1h10V3a2 2 0 0 0-2-2H5zm6 8H5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1z" /><path d="M0 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1v-2a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2H2a2 2 0 0 1-2-2V7zm2.5 1a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" /></svg>
                                        Ver imagen del QR
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <!-- Botón de editar (usando el Modal original) -->
                                    <button class="dropdown-item d-flex align-items-center gap-2 edit-qr-btn py-2 rounded" data-id="@qr.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#64748b" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                        Editar detalles
                                    </button>
                                </li>
                                <li>
                                    <!-- Botón de eliminar con confirmación -->
                                    <button class="dropdown-item text-danger d-flex align-items-center gap-2 py-2 rounded delete-qr-btn" data-id="@qr.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" /></svg>
                                        Eliminar QR
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Estado Vacío -->
        <div class="col-12 text-center py-5">
            <div class="bg-white p-5 rounded-4 border text-muted shadow-sm d-flex flex-column align-items-center">
                <div class="mb-3 p-3 bg-light rounded-circle text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M2 2h2v2H2V2Z" />
                        <path d="M6 0v6H0V0h6ZM5 1H1v4h4V1ZM4 12H2v2h2v-2Z" />
                        <path d="M6 10v6H0v-6h6Zm-5 1v4h4v-4H1Zm11-9h2v2h-2V2Z" />
                        <path d="M10 0h6v6h-6V0Zm5 1h-4v4h4V1ZM8 1V0h1v2H8v2H7V1h1Zm0 5V4h1v2H8ZM6 8V7h1V6h1v2h1V7h5v1h-4v1H7V8H6Zm0 0v1H2V8H1v1H0V7h3v1h3Zm10 1h-1V7h1v2Zm-1 0h-1v2h2v-1h-1V9Zm-4 0h2v1h-1v1h-1V9Zm2 3v-1h-1v1h-1v1H9v1h3v-2h1Zm0 0h3v1h-2v1h-1v-2Zm-4-1v1h1v-2H7v1h2Z" />
                    </svg>
                </div>
                <h4 class="h5 text-dark fw-bold mb-1">No hay códigos QR</h4>
                <p class="mb-0 text-secondary" style="font-size: 0.9rem;">Aún no se ha generado ningún código para la documentación de esta máquina.</p>
            </div>
        </div>
    }
</div>