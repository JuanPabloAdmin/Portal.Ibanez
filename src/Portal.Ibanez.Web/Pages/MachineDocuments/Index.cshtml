@page
@using Portal.Ibanez.Localization
@using Portal.Ibanez.Web.Pages.MachineDocuments
@using Microsoft.Extensions.Localization
@model IndexModel
@inject IStringLocalizer<IbanezResource> L

@section scripts {
    <script>
        $(function () {
            // Referencia al servicio JavaScript
            var docService = portal.ibanez.documents.machineDocument;

            // Configuración de los modales (Mantenemos exactamente tus rutas)
            var createModal = new abp.ModalManager({ viewUrl: abp.appPath + 'MachineDocuments/CreateModal' });
            var editModal = new abp.ModalManager({ viewUrl: abp.appPath + 'MachineDocuments/EditModal' });
            var uploadFolderModal = new abp.ModalManager({ viewUrl: abp.appPath + 'MachineDocuments/UploadFolderModal' });

            $('#NewDocumentButton').click(function (e) {
                e.preventDefault();
                createModal.open({
                    machineId: $('#MachineId').val(),
                    documentFolderId: $('#DocumentFolderId').val()
                });
            });

            $('#UploadFolderButton').click(function (e) {
                e.preventDefault();
                uploadFolderModal.open({
                    machineId: $('#MachineId').val(),
                    documentFolderId: $('#DocumentFolderId').val()
                });
            });

            $(document).on('click', '.edit-doc-btn', function (e) {
                e.preventDefault();
                editModal.open({ id: $(this).data('id') });
            });

            $(document).on('click', '.delete-doc-btn', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                abp.message.confirm('¿Seguro que deseas eliminar este documento?', function (isConfirmed) {
                    if (isConfirmed) {
                        docService.delete(id).then(function () {
                            abp.notify.success('Documento eliminado correctamente');
                            window.location.reload();
                        });
                    }
                });
            });

            // Opcional: Activar/Desactivar desde tu AppService
            $(document).on('click', '.toggle-active-btn', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                docService.toggleActive(id).then(function () {
                    abp.notify.success('Estado actualizado');
                    window.location.reload();
                });
            });

            createModal.onResult(function () { location.reload(); });
            editModal.onResult(function () { location.reload(); });
            uploadFolderModal.onResult(function () { location.reload(); });
        });
    </script>
}

<input type="hidden" id="MachineId" value="@Model.MachineId" />
<input type="hidden" id="DocumentFolderId" value="@Model.DocumentFolderId" />

<style>
    body {
        background-color: #f4f7f9;
        font-family: 'Inter', system-ui, sans-serif;
    }

    /* Botones de acción */
    .btn-brand {
        background-color: #c71712;
        color: white;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s;
        box-shadow: 0 4px 6px -1px rgba(199, 23, 18, 0.2);
    }

        .btn-brand:hover {
            background-color: #a5130f;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 8px -1px rgba(199, 23, 18, 0.3);
        }

    .btn-outline-brand {
        background-color: transparent;
        color: #475569;
        border: 1px solid #cbd5e1;
        padding: 0.5rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

        .btn-outline-brand:hover {
            background-color: #f8fafc;
            color: #1e293b;
            border-color: #94a3b8;
            transform: translateY(-1px);
        }

    /* Estructura Tarjetas */
    .doc-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

        .doc-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -5px rgba(0,0,0,0.08);
            border-color: #cbd5e1;
        }

        .doc-card.inactive {
            opacity: 0.75;
            background-color: #fafafa;
        }

    .doc-icon-container {
        height: 140px;
        background-color: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid #f1f5f9;
        color: #94a3b8;
        position: relative;
    }

    .badge-version {
        position: absolute;
        top: 12px;
        left: 12px;
        background-color: rgba(255,255,255,0.9);
        border: 1px solid #e2e8f0;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        color: #475569;
        backdrop-filter: blur(4px);
    }

    .badge-status {
        position: absolute;
        top: 12px;
        right: 12px;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        text-transform: uppercase;
    }

    .status-active {
        background-color: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .status-inactive {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* Colores por tipo de archivo */
    .icon-pdf {
        color: #ef4444;
    }

    .icon-word {
        color: #2563eb;
    }

    .icon-excel {
        color: #16a34a;
    }

    .icon-image {
        color: #8b5cf6;
    }

    .doc-info {
        padding: 1.25rem;
        flex-grow: 1;
    }

    .doc-actions {
        padding: 1rem 1.25rem;
        background-color: #fcfcfd;
        border-top: 1px solid #f1f5f9;
        display: flex;
        gap: 8px;
    }

    .btn-download {
        background-color: #f1f5f9;
        color: #0f172a;
        font-weight: 600;
        font-size: 0.75rem;
        flex-grow: 1;
        border-radius: 8px;
        padding: 0.5rem;
        border: none;
        transition: background-color 0.2s;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-download:hover {
            background-color: #e2e8f0;
            color: #000;
        }

    .btn-action-icon {
        background-color: transparent;
        border: 1px solid #cbd5e1;
        color: #475569;
        border-radius: 8px;
        width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

        .btn-action-icon:hover {
            background-color: #f1f5f9;
            color: #1e293b;
            border-color: #94a3b8;
        }
</style>

<!-- Cabecera Visual -->
<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white p-4 border rounded-4 shadow-sm gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                <li class="breadcrumb-item text-muted">Administración</li>
                <li class="breadcrumb-item text-muted">Máquinas</li>
                <li class="breadcrumb-item" style="color: #c71712;">Documentos</li>
            </ol>
        </nav>
        <h2 class="h4 font-weight-bold text-dark mb-0 d-flex align-items-center gap-2">
            <div class="p-2 bg-light rounded-3 text-secondary d-flex align-items-center justify-content-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31zM2.19 3c-.24 0-.47.042-.683.12L1.5 2.98a1 1 0 0 1 1-.98h3.672a1 1 0 0 1 .707.293L7.586 3H2.19zm9.608 5.272-1-1a.5.5 0 0 0-.708 0l-1 1a.5.5 0 1 0 .708.708l.146-.146v2.666a.5.5 0 0 0 1 0v-2.666l.146.146a.5.5 0 0 0 .708-.708z" /></svg>
            </div>
            @Model.Title
        </h2>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="button" id="UploadFolderButton" class="btn btn-outline-brand d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" /></svg>
            Subir carpeta
        </button>

        <button type="button" id="NewDocumentButton" class="btn btn-brand d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            Nuevo documento
        </button>
    </div>
</div>

<!-- Grid de Tarjetas -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
    @if (Model.Documents != null && Model.Documents.Any())
    {
        foreach (var doc in Model.Documents)
        {
            var extension = System.IO.Path.GetExtension(doc.FileName ?? doc.StoredFileName)?.ToLower();
            var iconClass = "text-secondary";
            var isPdf = extension == ".pdf";
            var isImage = extension == ".jpg" || extension == ".png" || extension == ".jpeg";
            var isWord = extension == ".doc" || extension == ".docx";
            var isExcel = extension == ".xls" || extension == ".xlsx";

            if (isPdf) iconClass = "icon-pdf";
            else if (isWord) iconClass = "icon-word";
            else if (isExcel) iconClass = "icon-excel";
            else if (isImage) iconClass = "icon-image";

            var cardActiveState = doc.IsActive ? "" : "inactive";

            <div class="col">
                <div class="doc-card shadow-sm @cardActiveState">

                    <!-- Contenedor Visual y Badges -->
                    <div class="doc-icon-container @iconClass">
                        <!-- Badge de Versión -->
                        <span class="badge-version">v@(doc.Version > 0 ? doc.Version : 1)</span>

                        <!-- Badge de Estado (IsActive) -->
                        @if (doc.IsActive)
                        {
                            <span class="badge-status status-active">Activo</span>
                        }
                        else
                        {
                            <span class="badge-status status-inactive">Inactivo</span>
                        }

                        <!-- Renderizado del Icono SVGs -->
                        @if (isPdf)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z" /><path d="M4.603 14.087a.81.81 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.68 7.68 0 0 1 1.482-.645 19.697 19.697 0 0 0 1.062-2.227 7.269 7.269 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.188-.012.396-.047.614-.084.51-.27 1.134-.52 1.794a10.954 10.954 0 0 0 .98 1.686 5.753 5.753 0 0 1 1.334.05c.364.066.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.856.856 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.712 5.712 0 0 1-.911-.95 11.651 11.651 0 0 0-1.997.406 11.307 11.307 0 0 1-1.02 1.51c-.292.35-.609.656-.927.787a.793.793 0 0 1-.58.029zm1.379-1.901c-.166.076-.32.156-.459.238-.328.194-.541.383-.647.547-.094.145-.096.25-.04.361.01.022.02.036.026.044a.266.266 0 0 0 .035-.012c.137-.056.355-.235.635-.572a8.18 8.18 0 0 0 .45-.606zm1.64-1.33a12.71 12.71 0 0 1 1.01-.193 11.744 11.744 0 0 1-.51-.858 20.801 20.801 0 0 1-.5 1.05zm2.446.45c.15.163.296.3.435.41.24.19.407.253.498.256a.107.107 0 0 0 .07-.015.307.307 0 0 0 .094-.125.436.436 0 0 0 .059-.2.095.095 0 0 0-.026-.063c-.052-.062-.2-.152-.518-.209a3.876 3.876 0 0 0-.612-.053zM8.078 7.8a6.7 6.7 0 0 0 .2-.828c.031-.188.043-.343.038-.465a.613.613 0 0 0-.032-.198.517.517 0 0 0-.145.04c-.087.035-.158.106-.196.283-.04.192-.03.469.046.822.024.111.054.227.09.346z" /></svg>
                        }
                        else if (isExcel)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z" /><path d="M5.884 6.68 8 9.219l2.116-2.54a.5.5 0 1 1 .768.641L8.651 10l2.233 2.68a.5.5 0 0 1-.768.64L8 10.781l-2.116 2.54a.5.5 0 0 1-.768-.641L7.349 10 5.116 7.32a.5.5 0 1 1 .768-.64z" /></svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" viewBox="0 0 16 16"><path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z" /></svg>
                        }
                    </div>

                    <!-- Datos del Documento -->
                    <div class="doc-info">
                        <h3 class="h6 fw-bold text-dark mb-1 text-truncate" title="@doc.Title">@(doc.Title ?? "Sin título")</h3>
                        <p class="text-muted small mb-0 text-truncate" title="@doc.FileName" style="font-size: 0.75rem;">@doc.FileName</p>
                    </div>

                    <!-- Botonera de Acciones -->
                    <div class="doc-actions">
                        <!-- LA RUTA DE DESCARGA CORREGIDA AQUÍ -->
                        <a href="/MachineDocuments/Download/@doc.Id" class="btn-download">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" /></svg>
                            Descargar
                        </a>

                        <div class="dropdown">
                            <button class="btn-action-icon h-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z" /></svg>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1 p-2" style="font-size: 0.85rem; border-radius: 10px;">
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2 edit-doc-btn py-2 rounded" data-id="@doc.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#64748b" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" /></svg>
                                        Editar detalles
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2 toggle-active-btn py-2 rounded" data-id="@doc.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#64748b" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" /><path d="M5 6.5A1.5 1.5 0 0 1 6.5 5h3A1.5 1.5 0 0 1 11 6.5v3A1.5 1.5 0 0 1 9.5 11h-3A1.5 1.5 0 0 1 5 9.5v-3z" /></svg>
                                        @(doc.IsActive ? "Desactivar" : "Activar") documento
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item text-danger d-flex align-items-center gap-2 py-2 rounded delete-doc-btn" data-id="@doc.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" /></svg>
                                        Eliminar
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="col-12 text-center py-5">
            <div class="bg-white p-5 rounded-4 border text-muted shadow-sm d-flex flex-column align-items-center">
                <div class="mb-3 p-3 bg-light rounded-circle text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16"><path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm5.5 1.5v2a1 1 0 0 0 1 1h2l-3-3zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" /></svg>
                </div>
                <h4 class="h5 text-dark fw-bold mb-1">Carpeta vacía</h4>
                <p class="mb-0 text-secondary" style="font-size: 0.9rem;">No hay documentos subidos en este directorio.</p>
            </div>
        </div>
    }
</div>