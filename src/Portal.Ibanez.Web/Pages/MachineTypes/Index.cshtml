@page
@using Portal.Ibanez.Localization
@using Portal.Ibanez.Web.Pages.MachineTypes
@using Microsoft.Extensions.Localization
@model IndexModel
@inject IStringLocalizer<IbanezResource> L

@section scripts {
    <script src="/Pages/MachineTypes/Index.js"></script>
}

<style>
    body {
        background-color: #f4f7f9;
        font-family: 'Inter', system-ui, sans-serif;
    }

    /* Botón Principal */
    .btn-brand {
        background-color: #c71712;
        color: white;
        border: none;
        padding: 0.5rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.2s;
        box-shadow: 0 4px 6px -1px rgba(199, 23, 18, 0.2);
    }

        .btn-brand:hover {
            background-color: #a5130f;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 6px 8px -1px rgba(199, 23, 18, 0.3);
        }

    /* Buscador */
    .search-wrapper {
        position: relative;
        width: 300px;
    }

        .search-wrapper svg {
            position: absolute;
            left: 12px;
            top: 12px;
            color: #94a3b8;
        }

        .search-wrapper input {
            padding-left: 2.5rem;
            border-radius: 0.5rem;
            border-color: #cbd5e1;
            font-size: 0.9rem;
        }

    /* Tarjetas de Tipo de Máquina */
    .machine-type-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .machine-type-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -8px rgba(0,0,0,0.08);
            border-color: #cbd5e1;
        }

    .card-body-custom {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        flex-grow: 1;
    }

    .icon-wrapper {
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        margin-bottom: 1rem;
        border: 1px solid #e2e8f0;
        transition: transform 0.3s ease, color 0.3s ease;
    }

    .machine-type-card:hover .icon-wrapper {
        transform: scale(1.05);
        color: #c71712;
        border-color: #fecaca;
        background: #fff5f5;
    }

    .type-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 0.5rem;
        width: 100%;
    }

    .badge-tag {
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        background-color: #f1f5f9;
        color: #64748b;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    /* Botonera Inferior */
    .card-footer-actions {
        padding: 1rem;
        background-color: #fafbfc;
        border-top: 1px dashed #f1f5f9;
        display: flex;
        gap: 8px;
    }

    .btn-action-main {
        background-color: #1e293b;
        color: white;
        font-weight: 600;
        font-size: 0.8rem;
        flex-grow: 1;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        border: none;
        transition: background-color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-action-main:hover {
            background-color: #0f172a;
            color: white;
        }

    .btn-action-delete {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        color: #ef4444;
        border-radius: 8px;
        width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

        .btn-action-delete:hover {
            background-color: #fef2f2;
            border-color: #fca5a5;
        }
</style>

<!-- Cabecera -->
<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white p-4 border rounded-4 shadow-sm gap-3">
    <h2 class="h4 text-dark mb-0 d-flex align-items-center gap-2">
        <div class="p-2 bg-light rounded-3 text-secondary d-flex align-items-center justify-content-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                <path d="M13 2.5a1.5 1.5 0 0 1 3 0v11a1.5 1.5 0 0 1-3 0v-.5H3v.5a1.5 1.5 0 0 1-3 0v-11a1.5 1.5 0 0 1 3 0v.5h10v-.5zM3 2a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5v-11A.5.5 0 0 0 13 2H3z" />
                <path d="M5.5 4a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h5a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-5zM6 5h4v1H6V5z" />
            </svg>
        </div>
        <div>
            <span class="text-muted fw-normal fs-6 d-block" style="line-height: 1;">Administración / Máquinas /</span>
            <span class="fw-bold">Tipos</span>
        </div>
    </h2>

    <div class="d-flex flex-wrap gap-3">
        <div class="search-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" /></svg>
            <input type="text" id="typeSearchInput" class="form-control shadow-sm" placeholder="Buscar tipo de máquina...">
        </div>
        <button id="NewMachineTypeButton" class="btn-brand d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            Nuevo tipo
        </button>
    </div>
</div>

<!-- Contenedor Grid (Inyectado por JS) -->
<div id="MachineTypesGrid" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
    <!-- El JS dibujará las tarjetas aquí -->
</div>