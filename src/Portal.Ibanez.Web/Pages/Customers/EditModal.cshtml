@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Portal.Ibanez.Localization
@using Portal.Ibanez.Web.Pages.Customers
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model EditModalModel
@inject IHtmlLocalizer<IbanezResource> L
@{
    Layout = null;
}

<form asp-page="/Customers/EditModal">
    <abp-modal>
        <abp-modal-header title="Editar cliente" class="bg-light border-bottom"></abp-modal-header>

        <abp-modal-body class="pt-4">
            <abp-input asp-for="Id" />
            <abp-select asp-for="Customer.CountryId"
                        asp-items="Model.Countries"
                        label="País">
                <option value="">-- Sin país --</option>
            </abp-select>
            <abp-input asp-for="Customer.CommercialName" />
            <abp-input asp-for="Customer.FiscalName" />
            <abp-input asp-for="Customer.TaxId" />
            <abp-input asp-for="Customer.Address" />
            <abp-input asp-for="Customer.Phone" />
            <abp-input asp-for="Customer.Email" />
            <abp-input asp-for="Customer.ContactPerson" />
        </abp-modal-body>

        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)">
        </abp-modal-footer>
    </abp-modal>
</form>
